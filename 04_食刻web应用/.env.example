# DashScope（通义兼容模式，推荐）
DASHSCOPE_API_KEY=
AMAP_API_KEY=

# OpenAI 兼容接口（可指向 DashScope / DeepSeek / 官方 OpenAI）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-flash
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# 推荐偏好加权（向量相似度 + PREFERENCE_WEIGHT * 偏好分）
PREFERENCE_WEIGHT=0.3

# 质量告警（可选）
ALERT_EMAIL=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# 数据路径（相对 backend 目录或绝对路径）
DB_PATH=data/sqlite/recipes.db
CHROMA_PATH=data/chroma_recipes
